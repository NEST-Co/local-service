---
import Service from '../layouts/Service.astro';
import Photo from '../components/Photo.astro';
---
<Service title="Maintenance plans" description="Two plans for yearly heating and cooling tune-ups, with clear prices." heading="Maintenance plans" lead="Two visits a year keep small problems small. Prices here are invented for this concept site.">
  <div class="wrap body">
    <div class="plans">
      <section class="plan"><h2>Basic</h2><p class="price">$189 <span style="font-size:1rem;font-family:var(--body);color:var(--muted)">a year</span></p>
        <ul class="checks"><li>One cooling tune-up and one heating tune-up</li><li>Written checklist each visit</li><li>Cancel any time</li></ul></section>
      <section class="plan featured"><h2>Plus</h2><p class="price">$279 <span style="font-size:1rem;font-family:var(--body);color:var(--muted)">a year</span></p>
        <ul class="checks"><li>Everything in Basic</li><li>Priority scheduling</li><li>10% off repairs</li><li>No after-hours fee on emergency calls</li></ul></section>
    </div>
    <div class="split">
      <div class="frame"><Photo name="maintenance" alt="A technician with a checklist changing a furnace filter while a homeowner watches." sizes="(min-width: 900px) 45vw, 100vw" /></div>
      <div><h2>What a visit looks like</h2><p>Your technician follows a written checklist, shows you what they found, and leaves you a copy. Small worn parts get caught before they fail on the coldest or hottest day.</p><p><a class="btn" href="/quote">Ask about a plan</a></p></div>
    </div>
  </div>
</Service>
