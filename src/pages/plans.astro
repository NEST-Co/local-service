---
import Service from '../layouts/Service.astro';
---
<Service title="Maintenance plans" description="Two plans for yearly heating and cooling tune-ups, with clear prices.">
  <div class="wrap">
    <h1>Maintenance plans</h1>
    <p>Two visits a year keep small problems small. Prices here are invented for this concept site.</p>
    <div class="plans">
      <section class="plan"><h2>Basic</h2><p class="price">$189 <span style="font-size:1rem">a year</span></p>
        <ul class="checks"><li>One cooling tune-up and one heating tune-up</li><li>Written checklist each visit</li><li>Cancel any time</li></ul></section>
      <section class="plan featured"><h2>Plus</h2><p class="price">$279 <span style="font-size:1rem">a year</span></p>
        <ul class="checks"><li>Everything in Basic</li><li>Priority scheduling</li><li>10% off repairs</li><li>No after-hours fee on emergency calls</li></ul></section>
    </div>
    <p><a class="btn" href="/quote">Ask about a plan</a></p>
  </div>
</Service>
