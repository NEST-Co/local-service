---
import Service from '../../layouts/Service.astro';
import Photo from '../../components/Photo.astro';
import { biz, services } from '../../data/business';
export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: s.title, description: s.short, provider: { '@type': 'HVACBusiness', name: biz.name }, areaServed: biz.areas },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: '/services' },
    { '@type': 'ListItem', position: 3, name: s.title } ] },
];
---
<Service title={s.title} description={`${s.title} in ${biz.city} and nearby towns. ${s.short}`} schema={schema}>
  <div class="wrap">
    <nav aria-label="Breadcrumb"><p><a href="/">Home</a> &rsaquo; <a href="/services">Services</a> &rsaquo; <span aria-current="page">{s.title}</span></p></nav>
    <div class="two">
      <div class="prose">
        <h1>{s.title}</h1>
        <p>{s.intro}</p>
        <h2>Signs you may need this</h2>
        <ul class="checks">{s.signs.map((x) => <li>{x}</li>)}</ul>
        <h2>How it works</h2>
        <ol class="checks">{s.steps.map((x) => <li>{x}</li>)}</ol>
        <h2>Common questions</h2>
        {s.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        <div class="actions">
          <a class="btn" href="/quote">Get a free quote</a>
          <a class="btn alt" href={`tel:${biz.phoneHref}`}>Call {biz.phone}</a>
        </div>
      </div>
      <Photo name={s.image} alt="" />
    </div>
  </div>
</Service>
