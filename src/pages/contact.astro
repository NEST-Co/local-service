---
import Service from '../layouts/Service.astro';
import { biz } from '../data/business';
---
<Service title="Contact" description="Phone, email, address and hours for Northfield Heating & Air.">
  <div class="wrap prose">
    <h1>Contact us</h1>
    <p><strong>Phone:</strong> <a href={`tel:${biz.phoneHref}`}>{biz.phone}</a><br /><strong>Email:</strong> <a href={`mailto:${biz.email}`}>{biz.email}</a><br /><strong>Address:</strong> {biz.street}, {biz.city}, {biz.region} {biz.zip}<br /><strong>Hours:</strong> {biz.hours}</p>
    <p>For a quote, use the <a href="/quote">quote form</a>.</p>
    <p class="urgent"><strong>Smell gas?</strong> Leave the house and call 911 and your gas company from outside.</p>
  </div>
</Service>
