---
import { Picture } from 'astro:assets';
import hero from '../assets/hero.png';
import heating from '../assets/heating.png';
import cooling from '../assets/cooling.png';
import maintenance from '../assets/maintenance.png';
interface Props { name: 'hero' | 'heating' | 'cooling' | 'maintenance'; alt?: string; eager?: boolean; sizes?: string }
const { name, alt = '', eager = false, sizes = '(min-width: 700px) 50vw, 100vw' } = Astro.props;
const images = { hero, heating, cooling, maintenance };
---
<Picture src={images[name]} alt={alt} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes={sizes}
  loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding={eager ? 'sync' : 'async'} class="pic" />
