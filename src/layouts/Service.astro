---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { biz } from '../data/business';
import '../styles/northfield.css';
interface Props { title: string; description?: string; schema?: object[]; heading?: string; lead?: string; eyebrow?: string; crumb?: { href: string; label: string }[]; home?: boolean }
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/plans', label: 'Plans' },
  { href: '/service-area', label: 'Service area' },
  { href: '/about', label: 'About' },
  { href: '/quote', label: 'Get a quote' },
];
const { title, description = `${title}: ${biz.name}, a fictional heating and cooling company.`, schema = [], heading, lead, eyebrow, crumb = [], home = false } = Astro.props;
const path = Astro.url.pathname;
const business = {
  '@context': 'https://schema.org', '@type': 'HVACBusiness',
  name: biz.name, telephone: biz.phone, email: biz.email, ...(Astro.site ? { url: Astro.site.href } : {}),
  address: { '@type': 'PostalAddress', streetAddress: biz.street, addressLocality: biz.city, addressRegion: biz.region, postalCode: biz.zip, addressCountry: 'US' },
  areaServed: biz.areas.map((name) => ({ '@type': 'City', name })),
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:00', closes: '18:00' }],
};
---
<Base title={title} description={description} siteName={biz.name}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>
  <div slot="header" class="site-head">
    <div class="topbar"><div class="wrap">
      <span><strong>No heat or cooling?</strong> Emergency service, 24 hours a day.</span>
      <span>Call <a href={`tel:${biz.phoneHref}`}>{biz.phone}</a></span>
    </div></div>
    <div class="wrap bar">
      <a class="brand" href="/"><Logo /><span class="brand-text"><span class="brand-name">Northfield</span><span class="brand-sub">Heating &amp; Air</span></span></a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          <li><a class="btn call" href={`tel:${biz.phoneHref}`}>Call {biz.phone}</a></li>
        </ul>
      </nav>
    </div>
  </div>
  {!home && heading && (
    <div class="page-head">
      <div class="wrap">
        <p class="crumbs"><a href="/">Home</a>{crumb.map((c) => <> <span aria-hidden="true">/</span> <a href={c.href}>{c.label}</a></>)} <span aria-hidden="true">/</span> <span>{eyebrow ?? title}</span></p>
        <h1>{heading}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
    </div>
  )}
  <slot />
  <div slot="footer" class="site-foot">
    <div class="wrap foot-grid">
      <div>
        <p class="foot-name">{biz.name}</p>
        <p>{biz.street}<br />{biz.city}, {biz.region} {biz.zip}</p>
        <p>{biz.hours}</p>
      </div>
      <div>
        <h2>Get in touch</h2>
        <p><a href={`tel:${biz.phoneHref}`}>{biz.phone}</a></p>
        <p><a href={`mailto:${biz.email}`}>{biz.email}</a></p>
        <p><a href="/quote">Free quote</a></p>
      </div>
      <div>
        <h2>Around the site</h2>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/contact">Contact</a></li><li><a href="/accessibility">Accessibility statement</a></li></ul>
      </div>
    </div>
  </div>
</Base>
